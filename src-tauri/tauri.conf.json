{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git History Viewer",
  "version": "0.0.9",
  "identifier": "com.usm.githistoryviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git History Viewer",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "visible": true,
        "backgroundColor": "#eef1f4",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../resources/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../resources/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
